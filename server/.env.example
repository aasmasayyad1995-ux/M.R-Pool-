# Copy to .env for local runs, or paste these into your host's environment settings.
# Never commit the real values: the admin token is the password to a page that hands out
# subscriptions.

# ---- Online play (optional) --------------------------------------------------------
# Nothing to set. The match server runs on the same port.

# ---- Subscriptions (optional) ------------------------------------------------------
# Leave UPI_ID or ADMIN_TOKEN blank and subscriptions switch off entirely. That is a
# safe state: the app's Pro screen says it is unavailable and nobody can be charged.

# Your UPI id — where players' money actually lands.
UPI_ID=yourname@okhdfcbank

# The name a player's UPI app shows them before they pay.
UPI_PAYEE_NAME=Mr. Pool

# Rupees per month, as a plain number.
SUBSCRIPTION_PRICE=99

# How many days one payment buys.
SUBSCRIPTION_DAYS=30

# The password for the approvals page. Generate a long random one:
#   openssl rand -hex 24
# Blank switches subscriptions off rather than leaving that page open to the internet.
ADMIN_TOKEN=

# Where paid subscribers are remembered. THIS MUST BE ON A DISK THAT SURVIVES A REDEPLOY.
# On a container with no mounted volume this file is wiped on every deploy, and every
# subscriber loses the month they paid for.
SUBSCRIPTION_STORE=/data/entitlements.jsonl
